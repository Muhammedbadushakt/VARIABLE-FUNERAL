{
  "name": "variable-funeral",
  "displayName": "Variable Funeral",
  "description": "Detects dead code and gives it a proper burial.",
  "version": "0.2.0",
  "publisher": "variable-funeral",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "variableFuneral.scanFile",
        "title": "Variable Funeral: Scan Current File",
        "icon": "$(search)"
      },
      {
        "command": "variableFuneral.scanWorkspace",
        "title": "Variable Funeral: Scan Entire Workspace",
        "icon": "$(search-fuzzy)"
      },
      {
        "command": "variableFuneral.openGraveyard",
        "title": "Variable Funeral: Open Graveyard",
        "icon": "$(circle-outline)"
      },
      {
        "command": "variableFuneral.clear",
        "title": "Variable Funeral: Clear Results",
        "icon": "$(clear-all)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "variableFuneral.scanFile"
        },
        {
          "command": "variableFuneral.scanWorkspace"
        },
        {
          "command": "variableFuneral.openGraveyard"
        },
        {
          "command": "variableFuneral.clear"
        }
      ]
    },
    "configuration": {
      "title": "Variable Funeral",
      "properties": {
        "variableFuneral.autoScanOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically scan the current file every time it is saved."
        },
        "variableFuneral.ignorePatterns": {
          "type": "array",
          "default": [
            "node_modules/**",
            "out/**",
            "dist/**",
            "**/*.d.ts"
          ],
          "description": "Glob patterns to exclude from workspace scans."
        },
        "variableFuneral.ignoreNames": {
          "type": "array",
          "default": [
            "_",
            "__",
            "props",
            "React"
          ],
          "description": "Identifier names that should never be reported as dead, even if unused."
        }
      }
    }
  },
  "dependencies": {
    "typescript": "^5.4.0"
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.57.0",
    "esbuild": "^0.21.0",
    "npm-run-all": "^4.1.5",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.3.9"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}